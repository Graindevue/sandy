# GitHub personal access token. The orchestrator also reads `gh auth token`, so
# this is only needed if the `gh` CLI is not logged in on the host.
GH_TOKEN=

# Cursor Agent API key — required by the planner agent (sandcastle.cursor).
# Get one from https://cursor.com/dashboard (API keys).
CURSOR_API_KEY=

# Codex uses your local ChatGPT/Codex login from ~/.codex, which is mounted
# into the sandbox. Run `codex login` on the host if this is missing/expired.
# Do not set OPENAI_API_KEY/CODEX_API_KEY here unless you want API billing.
